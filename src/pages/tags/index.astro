---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/posts';
import { href } from '../../lib/url';

const posts = await getPublishedPosts();
const counts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}
const tags = [...counts.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---

<BaseLayout title="Tags">
  <p class="listing-label">Index of /tags &mdash; {tags.length} {tags.length === 1 ? 'entry' : 'entries'}</p>

  {tags.length === 0 ? (
    <p>No tags yet.</p>
  ) : (
    <table class="listing">
      <thead>
        <tr>
          <th class="col-name">Name</th>
          <th class="col-date">Posts</th>
        </tr>
      </thead>
      <tbody>
        {tags.map(([tag, count]) => (
          <tr>
            <td class="col-name"><a href={href(`/tags/${tag}`)}>{tag}/</a></td>
            <td class="col-date">{count}</td>
          </tr>
        ))}
      </tbody>
    </table>
  )}
</BaseLayout>
