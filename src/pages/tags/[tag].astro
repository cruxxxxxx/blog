---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, formatDate, type Post } from '../../lib/posts';
import { href } from '../../lib/url';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const byTag = new Map<string, Post[]>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      byTag.set(tag, [...(byTag.get(tag) ?? []), post]);
    }
  }
  return [...byTag.entries()].map(([tag, tagged]) => ({
    params: { tag },
    props: { tag, posts: tagged },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag}`}>
  <div class="prose">
    <h1 class="post-title">#{tag}</h1>
    <ul class="post-list">
      {posts.map((post) => (
        <li class="post-item">
          <h2><a href={href(`/${post.id}`)}>{post.data.title}</a></h2>
          <div class="meta">
            <time datetime={post.data.pubDate.toISOString()}>
              {formatDate(post.data.pubDate)}
            </time>
          </div>
          {post.data.description && <p>{post.data.description}</p>}
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
