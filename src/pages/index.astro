---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts, formatDate } from '../lib/posts';
import { href } from '../lib/url';

const posts = await getPublishedPosts();
---

<BaseLayout>
  <p class="listing-label">Index of / &mdash; {posts.length} {posts.length === 1 ? 'entry' : 'entries'}</p>

  {posts.length === 0 ? (
    <p>Empty. Add a markdown file to <code>Blogs/</code>.</p>
  ) : (
    <table class="listing">
      <thead>
        <tr>
          <th class="col-name">Name</th>
          <th class="col-date">Last modified</th>
          <th class="col-tags">Tags</th>
        </tr>
      </thead>
      <tbody>
        {posts.map((post) => (
          <tr>
            <td class="col-name">
              <a href={href(`/${post.id}`)}>{post.data.title}</a>
              {post.data.draft && <span class="draft-mark"> [draft]</span>}
            </td>
            <td class="col-date">
              {formatDate(post.data.updatedDate ?? post.data.pubDate)}
            </td>
            <td class="col-tags">
              {post.data.tags.length === 0
                ? '-'
                : post.data.tags.map((tag, i) => (
                    <>
                      {i > 0 && ', '}
                      <a href={href(`/tags/${tag}`)}>{tag}</a>
                    </>
                  ))}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  )}
</BaseLayout>
