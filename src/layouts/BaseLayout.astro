---
import '../styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION } from '../site';
import { href } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description = SITE_DESCRIPTION,
  image,
  type = 'website',
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
const isBlogHome = Astro.url.pathname.replace(/\/$/, '') === href('/').replace(/\/$/, '');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={new URL(href('/rss.xml'), Astro.site)}
    />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />

    {/* the dotted display face from hypnotize.works; inline so the URL follows `base` */}
    <style is:inline set:html={`
      @font-face {
        font-family: 'arrayregular';
        src: url('${href('/fonts/array.woff2')}') format('woff2'),
             url('${href('/fonts/array.woff')}') format('woff');
        font-display: swap;
      }
    `} />
  </head>

  <body>
    <header class="masthead">
      <span class="masthead-side">
        {!isBlogHome && <a class="back" href={href('/')} aria-label="back to the blog">&larr;</a>}
      </span>
      <a class="logo" href={href('/')} aria-label="blog home">
        <img src={href('/logo.png')} alt="hypnotize inc." width="400" height="167" />
      </a>
      <span class="masthead-side masthead-right">
        <a href="https://hypnotize.works">hypnotize.works</a>
      </span>
    </header>

    <main>
      <slot />
    </main>

    {/* click a photo to see it large; Escape, a click or a tap closes it */}
    <dialog class="lightbox" aria-label="enlarged photo">
      <img alt="" />
    </dialog>

    <script is:inline>
      (function () {
        var lightbox = document.querySelector('.lightbox');
        var enlarged = lightbox.querySelector('img');

        document.addEventListener('click', function (event) {
          var photo = event.target.closest('.post-body img');
          if (!photo || photo.closest('a')) {
            return;
          }
          enlarged.src = photo.currentSrc || photo.src;
          enlarged.alt = photo.alt;
          lightbox.showModal();
        });

        lightbox.addEventListener('click', function () {
          lightbox.close();
        });

        lightbox.addEventListener('close', function () {
          enlarged.removeAttribute('src');
        });
      })();
    </script>
  </body>
</html>
