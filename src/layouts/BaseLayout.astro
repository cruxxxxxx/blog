---
import '../styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION } from '../site';
import { href } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description = SITE_DESCRIPTION,
  image,
  type = 'website',
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={new URL(href('/rss.xml'), Astro.site)}
    />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />

    {/* the dotted display face from hypnotize.works; inline so the URL follows `base` */}
    <style is:inline set:html={`
      @font-face {
        font-family: 'arrayregular';
        src: url('${href('/fonts/array.woff2')}') format('woff2'),
             url('${href('/fonts/array.woff')}') format('woff');
        font-display: swap;
      }
    `} />
  </head>

  <body>
    <header class="masthead">
      <a class="logo" href={href('/')} aria-label="blog home">
        <img src={href('/logo.png')} alt="hypnotize inc." width="400" height="167" />
      </a>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-foot">
      <a href="https://hypnotize.works">hypnotize.works</a>
      <a href={href('/tags')}>tags</a>
      <a href={href('/rss.xml')}>rss</a>
    </footer>
  </body>
</html>
