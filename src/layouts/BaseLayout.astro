---
import '../styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION } from '../site';
import { href } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description = SITE_DESCRIPTION,
  image,
  type = 'website',
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={new URL(href('/rss.xml'), Astro.site)}
    />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />

    {/* Runs before first paint so an explicit choice never flashes the wrong theme. */}
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.setAttribute('data-theme', saved);
          }
        } catch (e) {
          /* private mode: fall through to the system preference */
        }
      })();
    </script>
  </head>

  <body>
    <header class="masthead">
      <h1><a href={href('/')}>{SITE_TITLE}</a></h1>
      <p class="tagline"><a href="https://hypnotize.works">hypnotize.works</a></p>
      <nav class="navbar">
        <span class="navlinks">
          <a href={href('/')}>home</a>
          <a href={href('/tags')}>tags</a>
          <a href={href('/rss.xml')}>rss</a>
        </span>
        <button id="theme-toggle" type="button" aria-live="polite">theme: auto</button>
      </nav>
      <hr />
    </header>

    <main>
      <slot />
    </main>

    <script is:inline>
      (function () {
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;

        // auto -> light -> dark -> auto
        var ORDER = ['auto', 'light', 'dark'];

        function read() {
          try {
            var v = localStorage.getItem('theme');
            return v === 'light' || v === 'dark' ? v : 'auto';
          } catch (e) {
            return 'auto';
          }
        }

        function apply(mode) {
          if (mode === 'auto') {
            document.documentElement.removeAttribute('data-theme');
          } else {
            document.documentElement.setAttribute('data-theme', mode);
          }
          btn.textContent = 'theme: ' + mode;
          try {
            if (mode === 'auto') {
              localStorage.removeItem('theme');
            } else {
              localStorage.setItem('theme', mode);
            }
          } catch (e) {
            /* choice just will not persist */
          }
        }

        apply(read());

        btn.addEventListener('click', function () {
          apply(ORDER[(ORDER.indexOf(read()) + 1) % ORDER.length]);
        });
      })();
    </script>
  </body>
</html>
