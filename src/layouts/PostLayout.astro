---
import BaseLayout from './BaseLayout.astro';
import { formatDate, type Post } from '../lib/posts';
import { href } from '../lib/url';

interface Props {
  post: Post;
  prev?: Post;
  next?: Post;
}

const { post, prev, next } = Astro.props;
const { title, description, pubDate, updatedDate, tags, cover, coverAlt, draft } = post.data;
---

<BaseLayout title={title} description={description} image={cover} type="article">
  <article>
    <header class="post-head">
      <h1>{title}{draft && <span class="draft-mark"> [draft]</span>}</h1>
      <p class="byline">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && <> &middot; updated {formatDate(updatedDate)}</>}
        {tags.length > 0 && (
          <>
            {' '}&middot;{' '}
            {tags.map((tag, i) => (
              <>
                {i > 0 && ', '}
                <a href={href(`/tags/${tag}`)}>{tag}</a>
              </>
            ))}
          </>
        )}
      </p>
    </header>

    <div class="post-body">
      {cover && <img src={cover} alt={coverAlt} loading="eager" decoding="async" />}
      <slot />
    </div>

    <hr />
    <nav class="pager">
      {next ? <a href={href(`/${next.id}`)}>&larr; {next.data.title}</a> : <span>&nbsp;</span>}
      {prev ? <a href={href(`/${prev.id}`)}>{prev.data.title} &rarr;</a> : <span>&nbsp;</span>}
    </nav>
  </article>
</BaseLayout>
