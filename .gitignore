# Local setup script — prompts for R2 credentials at runtime.
setup.sh

# Obsidian — contains plugin credentials (R2 keys). NEVER commit.
.obsidian/
.trash/

# Node / Astro
node_modules/
dist/
.astro/
.DS_Store
*.log

# Pasted photos, pre-upload. R2 is the delivery path; committing these would
# double storage and serve images from Pages instead. A build failure here
# (ImageNotFound) means you forgot to run "Publish Page".
Blogs/assets/

# Local originals — full-size exports never get committed
Originals/
*.NEF
*.nef
